{% for entry in tree -%}
{# --- Definitions: build groups first --- #}
{##}
{# Changed #}
{% set changed_verbs = ["move", "rename", "deprecate"] -%}
{% set changed = [] -%}
{% for c in entry.changes.get("Perf", []) -%}
  {% if not c.message.lower().startswith("fix") -%}
    {% set _ = changed.append(c) -%}
  {% endif -%}
{% endfor -%}
{% for c in entry.changes.get("Refactor", []) -%}
  {% if not c.message.lower().startswith("fix") -%}
    {% set _ = changed.append(c) -%}
  {% endif -%}
{% endfor -%}
{% for c in entry.changes.get("Revert", []) %}{% set _ = changed.append(c) %}{% endfor -%}
{% for type, changes in entry.changes.items() -%}
  {% if type not in ["Style","Chore"] -%}
    {% for c in changes -%}
      {% for verb in changed_verbs -%}
        {% if c.message.lower().startswith(verb) -%}
          {% set _ = changed.append(c) -%}
        {% endif -%}
      {% endfor -%}
    {% endfor -%}
  {% endif -%}
{% endfor -%}
{##}
{# Added #}
{% set added_verbs = ["add", "introduce"] -%}
{% set added = [] -%}
{% for c in entry.changes.get("Feat", []) %}{% set _ = added.append(c) %}{% endfor -%}
{% for type, changes in entry.changes.items() -%}
  {% if type not in ["Perf","Refactor","Fix","Style","Chore"] -%}
    {% for c in changes -%}
      {% for verb in added_verbs -%}
        {% if c.message.lower().startswith(verb) -%}
          {% set _ = added.append(c) -%}
        {% endif -%}
      {% endfor -%}
    {% endfor -%}
  {% endif -%}
{% endfor -%}
{##}
{# Removed #}
{% set removed_verbs = ["remove", "delete", "drop"] -%}
{% set removed = [] -%}
{% for type, changes in entry.changes.items() -%}
  {% if type not in ["Style","Chore"] -%}
    {% for c in changes -%}
      {% for verb in removed_verbs -%}
        {% if c.message.lower().startswith(verb) -%}
          {% set _ = removed.append(c) -%}
        {% endif -%}
      {% endfor -%}
    {% endfor -%}
  {% endif -%}
{% endfor -%}
{##}
{# Fixed #}
{% set fixed_verbs = ["fix"] -%}
{% set fixed = [] -%}
{% for c in entry.changes.get("Fix", []) -%}
  {% if c.type != "Docs" -%}
    {% set _ = fixed.append(c) -%}
  {% endif -%}
{% endfor -%}
{% for type, changes in entry.changes.items() -%}
  {% if type not in ["Style","Chore","Docs"] -%}
    {% for c in changes -%}
      {% for verb in fixed_verbs -%}
        {% if c.message.lower().startswith(verb) -%}
          {% set _ = fixed.append(c) -%}
        {% endif -%}
      {% endfor -%}
    {% endfor -%}
  {% endif -%}
{% endfor -%}
{##}
{# --- Output starts here --- #}
{##}
## {{ entry.version|replace("v", "") }} - {{ entry.date }}
{##}
{% if changed %}

### 🔄 Changed

{% for change in changed -%}
- {% if change.footer and "breaking" in change.footer|lower -%}
  **Breaking:** {{ change.message }}
{% elif change.scope and change.footer and "breaking" in change.footer|lower -%}
  **{{ change.scope }} (breaking):** {{ change.message }}
{% elif change.scope -%}
  **{{ change.scope }}:** {{ change.message }}
{% else -%}
  {{ change.message }}
{% endif -%}
{% endfor -%}
{% endif %}
{##}
{% if added %}

### 🆕 Added

{% for change in added -%}
- {% if change.footer and "breaking" in change.footer|lower -%}
  **Breaking:** {{ change.message }}
{% elif change.scope and change.footer and "breaking" in change.footer|lower -%}
  **{{ change.scope }} (breaking):** {{ change.message }}
{% elif change.scope -%}
  **{{ change.scope }}:** {{ change.message }}
{% else -%}
  {{ change.message }}
{% endif -%}
{% endfor -%}
{% endif %}
{##}
{% if removed %}

### 🗑️ Removed

{% for change in removed -%}
- {% if change.footer and "breaking" in change.footer|lower -%}
  **Breaking:** {{ change.message }}
{% elif change.scope and change.footer and "breaking" in change.footer|lower -%}
  **{{ change.scope }} (breaking):** {{ change.message }}
{% elif change.scope -%}
  **{{ change.scope }}:** {{ change.message }}
{% else -%}
  {{ change.message }}
{% endif -%}
{% endfor -%}
{% endif %}
{##}
{% if fixed %}

### 🐛 Fixed

{% for change in fixed -%}
- {% if change.footer and "breaking" in change.footer|lower -%}
  **Breaking:** {{ change.message }}
{% elif change.scope and change.footer and "breaking" in change.footer|lower -%}
  **{{ change.scope }} (breaking):** {{ change.message }}
{% elif change.scope -%}
  **{{ change.scope }}:** {{ change.message }}
{% else -%}
  {{ change.message }}
{% endif -%}
{% endfor -%}
{% endif %}
{##}

{% endfor -%}